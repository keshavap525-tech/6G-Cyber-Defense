from backend.services.detection_service import DetectionService
import threading
import time
import random
from datetime import datetime


class SimulationController:

    def __init__(self):
        self.detection_service = DetectionService()

        self.running = False
        self.thread = None

        self.total_packets = 0
        self.total_threats = 0
        self.total_incidents = 0

        self.current_attack = "NONE"

        self.last_event = None
        self.last_analysis = None

        self.lock = threading.Lock()

        # Detection service will be loaded when simulator starts
        self.detection_service = None


    # ============================================================
    # GENERATE 6G NETWORK TRAFFIC
    # ============================================================

    def _generate_traffic(self):

        while self.running:

            traffic = {
                "timestamp": datetime.utcnow().isoformat(),

                "src_ip": (
                    f"10.0.0.{random.randint(2, 254)}"
                ),

                "dst_ip": (
                    f"10.0.1.{random.randint(2, 254)}"
                ),

                "src_port": random.randint(
                    1024,
                    65535
                ),

                "dst_port": random.choice(
                    [
                        22,
                        53,
                        80,
                        443,
                        8080
                    ]
                ),

                "protocol": random.choice(
                    [
                        "TCP",
                        "UDP"
                    ]
                ),

                "packet_count": random.randint(
                    10,
                    1000
                ),

                "bytes": random.randint(
                    500,
                    100000
                ),

                "duration": round(
                    random.uniform(
                        0.1,
                        10.0
                    ),
                    3
                ),

                "attack_type": self.current_attack
            }


            # ====================================================
            # SAVE GENERATED TRAFFIC
            # ====================================================

            with self.lock:

                self.total_packets += (
                    traffic["packet_count"]
                )

                self.last_event = traffic


            # ====================================================
            # SEND TRAFFIC TO DETECTION SERVICE
            # ====================================================

            if self.detection_service:

                try:

                    analysis = (
                        self.detection_service.analyze(
                            traffic
                        )
                    )

                    with self.lock:

                        self.last_analysis = analysis

                        # ----------------------------------------
                        # Detect possible threat
                        # ----------------------------------------

                        if self._is_threat(
                            analysis
                        ):

                            self.total_threats += 1


                        # ----------------------------------------
                        # Detect created incident
                        # ----------------------------------------

                        if self._has_incident(
                            analysis
                        ):

                            self.total_incidents += 1


                except Exception as error:

                    with self.lock:

                        self.last_analysis = {
                            "success": False,
                            "error": str(error)
                        }


            time.sleep(1)


    # ============================================================
    # THREAT DETECTION HELPER
    # ============================================================

    def _is_threat(self, analysis):

        if not isinstance(
            analysis,
            dict
        ):

            return False


        # Direct prediction

        prediction = analysis.get(
            "prediction"
        )

        if prediction:

            prediction_text = str(
                prediction
            ).lower()

            if prediction_text not in [
                "normal",
                "benign",
                "safe",
                "none",
                "0"
            ]:

                return True


        # Nested analysis result

        nested = analysis.get(
            "analysis"
        )

        if isinstance(
            nested,
            dict
        ):

            prediction = nested.get(
                "prediction"
            )

            if prediction:

                prediction_text = str(
                    prediction
                ).lower()

                if prediction_text not in [
                    "normal",
                    "benign",
                    "safe",
                    "none",
                    "0"
                ]:

                    return True


            threat_level = nested.get(
                "threat_level"
            )

            if threat_level:

                level = str(
                    threat_level
                ).upper()

                if level in [
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                ]:

                    return True


        return False


    # ============================================================
    # INCIDENT DETECTION HELPER
    # ============================================================

    def _has_incident(self, analysis):

        if not isinstance(
            analysis,
            dict
        ):

            return False


        if analysis.get(
            "incident_id"
        ):

            return True


        nested = analysis.get(
            "analysis"
        )

        if isinstance(
            nested,
            dict
        ):

            if nested.get(
                "incident_id"
            ):

                return True


        return False


    # ============================================================
    # START SIMULATOR
    # ============================================================

    def start(self):

        if self.running:

            return {
                "success": False,
                "message": "Simulator is already running"
            }


        # --------------------------------------------------------
        # Load DetectionService
        # --------------------------------------------------------

        try:

            from backend.services.detection_service import (
                DetectionService
            )

            self.detection_service = (
                DetectionService()
            )

        except Exception as error:

            return {
                "success": False,
                "message": "DetectionService could not be loaded",
                "error": str(error)
            }


        self.running = True


        self.thread = threading.Thread(
            target=self._generate_traffic,
            daemon=True
        )


        self.thread.start()


        return {
            "success": True,
            "message": "6G simulator started",
            "detection": "enabled"
        }


    # ============================================================
    # STOP SIMULATOR
    # ============================================================

    def stop(self):

        if not self.running:

            return {
                "success": False,
                "message": "Simulator is not running"
            }


        self.running = False


        return {
            "success": True,
            "message": "6G simulator stopped"
        }


    # ============================================================
    # CHANGE ATTACK TYPE
    # ============================================================

    def set_attack(
        self,
        attack_type
    ):

        allowed_attacks = [
            "NONE",
            "DDOS",
            "PORT_SCAN",
            "BOTNET"
        ]


        attack_type = (
            attack_type.upper()
        )


        if attack_type not in allowed_attacks:

            return {
                "success": False,
                "message": "Unknown attack type",
                "allowed": allowed_attacks
            }


        self.current_attack = (
            attack_type
        )


        return {
            "success": True,
            "attack": attack_type
        }


    # ============================================================
    # STATUS
    # ============================================================

    def status(self):

        with self.lock:

            return {
                "running": self.running,

                "total_packets": (
                    self.total_packets
                ),

                "total_threats": (
                    self.total_threats
                ),

                "total_incidents": (
                    self.total_incidents
                ),

                "current_attack": (
                    self.current_attack
                ),

                "last_event": (
                    self.last_event
                ),

                "last_analysis": (
                    self.last_analysis
                ),
                "threat_score": 0
            }


# ================================================================
# GLOBAL SIMULATOR INSTANCE
# ================================================================

simulation_controller = (
    SimulationController()
)